# ==========================================
# MongoDB Configuration (Local or MongoDB Atlas)
# ==========================================

# Option A: MongoDB Atlas (Recommended for Deployment)
# Format: mongodb+srv://<username>:<password>@<cluster-name>.xxxxxx.mongodb.net/?retryWrites=true&w=majority
# Make sure to replace <username> and <password> with your actual Atlas Database User credentials.
# Also ensure Network Access in MongoDB Atlas allows access from anywhere (0.0.0.0/0) or your deployment server IP.
# MONGODB_URL=mongodb+srv://admin:YourSecurePassword123@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority

# Option B: Local MongoDB (Default for local development)
MONGODB_URL=mongodb://localhost:27017

# Database Name (will be created automatically if it doesn't exist)
DATABASE_NAME=spendnest_revenue_intelligence

# ==========================================
# Server & Deployment Configuration
# ==========================================
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated, or * to allow all origins in production)
CORS_ORIGINS=*

# Dataset Paths (optional overrides; defaults to bundled candidate data if omitted)
# INITIAL_DATA_PATH=../candidate-v1.0 (3)_layout_fixed (1)(2) (3)/candidate/data/01_initial.json
# UPDATE_DATA_PATH=../candidate-v1.0 (3)_layout_fixed (1)(2) (3)/candidate/data/02_update.json

# Export Output Directory (optional override)
# EXPORTS_DIR=../exports
