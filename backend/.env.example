# ==========================================
# SpendNest Revenue Intelligence Environment
# Zero External Database Dependency Required!
# Data persists locally to data/spendnest_store.json
# ==========================================

# Database & Storage Name
DATABASE_NAME=spendnest_revenue_intelligence

# Optional storage file path override (defaults to data/spendnest_store.json)
# STORAGE_FILE_PATH=../data/spendnest_store.json

# ==========================================
# Server & Deployment Configuration
# ==========================================
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated, or * to allow all origins in production)
CORS_ORIGINS=*

# Dataset Paths (optional overrides; defaults to bundled candidate data if omitted)
# INITIAL_DATA_PATH=../data/01_initial.json
# UPDATE_DATA_PATH=../data/02_update.json

# Export Output Directory (optional override)
# EXPORTS_DIR=../exports
